{
    "name": "ghosttext",
    "version": "0.0.5",
    "type": "module",
    "license": "MIT",
    "publisher": "ngyuki",
    "displayName": "GhostText",
    "description": "Use your text editor to write in your browser. Everything you type in the editor will be instantly updated in the browser (and vice versa).",
    "icon": "images/gticon.png",
    "repository": "https://github.com/ngyuki/ghosttext-vscode",
    "categories": [
        "Other"
    ],
    "keywords": [
        "ghosttext"
    ],
    "engines": {
        "vscode": "^1.134.0"
    },
    "main": "./src/extension.ts",
    "contributes": {
        "configuration": {
            "type": "object",
            "title": "Ghost Text",
            "properties": {
                "ghosttext.serverPort": {
                    "type": "number",
                    "default": 4001,
                    "description": "Server Port"
                }
            }
        }
    },
    "activationEvents": [
        "*"
    ],
    "scripts": {
        "vscode:prepublish": "npm run check",
        "check": "tsc",
        "watch": "tsc -watch",
        "package": "npx @vscode/vsce package --allow-star-activation --skip-license",
        "install": "code --install-extension ghosttext-*.vsix --force",
        "publish": "npx @vscode/vsce publish --allow-star-activation --skip-license"
    },
    "dependencies": {
        "ws": "^8.21.3"
    },
    "devDependencies": {
        "@tsconfig/node24": "^24.0.5",
        "@types/node": "^24.13.3",
        "@types/vscode": "^1.134.0",
        "@types/ws": "^8.18.1"
    }
}
